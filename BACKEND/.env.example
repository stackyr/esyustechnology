# ==========================================
# ESYUS BACKEND ENVIRONMENT VARIABLES
# ==========================================

# Port
PORT=5000

# MongoDB Connection String (MongoDB Atlas Cloud for Production)
# Example Atlas URI:
# MONGODB_URI=mongodb+srv://<db_user>:<db_password>@cluster0.abcde.mongodb.net/esyus_db?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/esyus_db

# ==========================================
# CORS & VERCEL PRODUCTION CLIENT DOMAINS
# ==========================================
# (All *.vercel.app domains are automatically allowed out-of-the-box)
# Primary frontend domain:
CLIENT_URL=https://esyustechnology.com

# Secondary or alternative frontend domain:
FRONTEND_URL=https://www.esyustechnology.com

# Additional origins separated by comma:
ALLOWED_ORIGINS=https://esyustechnology.com,https://www.esyustechnology.com,http://localhost:5173

# Set to true to permit all origins (useful during initial test deployment)
ALLOW_ALL_ORIGINS=false

# ==========================================
# ADMIN CREDENTIALS & SECURITY
# ==========================================
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin
ADMIN_SECRET=esyus_secure_admin_auth_token_secret_2027
